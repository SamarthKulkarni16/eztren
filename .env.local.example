# Copy this file to .env.local for local dev, or add these as
# Environment Variables in the Vercel project settings for production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_, this must not reach the
# browser. From dashboard.daily.co → Developers.
DAILY_API_KEY=

# --- AI player bots (app/api/battles/ai-turn, ai-topic-response) ---
# Tried in this order: Groq -> OpenRouter, falling to the next the moment
# one fails or its tokens run out — even mid-battle, since every turn is
# its own request. lib/ai-players.ts. Only GROQ_API_KEY is strictly
# required; OPENROUTER_API_KEY is an optional fallback but strongly
# recommended so a battle doesn't stall if Groq runs dry.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_PLAYER_MODEL=openai/gpt-oss-20b:free

# --- Judging (app/api/judge, app/api/battles/confirm-topic) ---
# Gemini is the primary judge (and the only one that can take the inline
# audio recording for voice battles). OPENROUTER_API_KEY (above) is reused
# as the judge fallback if Gemini is unreachable or exhausted - see
# lib/ai-judge.ts. Both OpenRouter judge defaults below are free (:free)
# models so the fallback works with zero purchased credits; the audio one
# is a separate model because most free-tier models can't take audio input.
GEMINI_API_KEY=
OPENROUTER_JUDGE_MODEL=openai/gpt-oss-20b:free
OPENROUTER_JUDGE_AUDIO_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Server-only — Cloudflare R2, used to store client-recorded audio battle
# recordings (app/api/battles/upload-recording/route.ts). Create a bucket +
# an R2 API token (Object Read & Write, scoped to that bucket) from the
# Cloudflare dashboard → R2 → Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for the bucket, no trailing slash — either the bucket's
# r2.dev public URL, or a custom domain connected via R2 → bucket settings
# → Public access (e.g. https://recordings.eztren.xyz, using your existing
# eztren.xyz Cloudflare zone).
R2_PUBLIC_URL=
