# Copy this file to .env.local for local dev, or add these as
# Environment Variables in the Vercel project settings for production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_, this must not reach the
# browser. From dashboard.daily.co → Developers.
DAILY_API_KEY=

# Server-only — Cloudflare R2, used to store client-recorded audio battle
# recordings (app/api/battles/upload-recording/route.ts). Create a bucket +
# an R2 API token (Object Read & Write, scoped to that bucket) from the
# Cloudflare dashboard → R2 → Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for the bucket, no trailing slash — either the bucket's
# r2.dev public URL, or a custom domain connected via R2 → bucket settings
# → Public access (e.g. https://recordings.eztren.xyz, using your existing
# eztren.xyz Cloudflare zone).
R2_PUBLIC_URL=
